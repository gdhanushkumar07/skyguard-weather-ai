# ==============================================================================
# SkyGuard AI Environment Configuration (.env.example)
# ==============================================================================
# All variables are optional with sensible defaults for local development.
# Rename this file to .env in your root directory if custom overrides are needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
WEATHER_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Pipeline Runtime Controls
# ------------------------------------------------------------------------------
ATHER_PIPELINE_ENABLED=1
ATHER_SIM_ENABLED=1
ATHER_REFERENCE_ENABLED=1
ATHER_SIM_INTERVAL_S=60
# ATHER_SIM_MAX_STATIONS=296
ATHER_STREAM_CAPACITY=20000
ATHER_RETENTION_HOURS=24
ATHER_DEFER_STARTUP_EVAL=1
ATHER_SKIP_STARTUP_EVAL=0

# ------------------------------------------------------------------------------
# 3. Model & PyTorch Flags
# ------------------------------------------------------------------------------
# Controls whether PyTorch-based inference (PINN & LSTM) is loaded into memory.
# Set to 0 in low-memory environments (e.g., Render 512MB free tier) to prevent OOM.
ATHER_ENABLE_TORCH=1
ATHER_MULTIVARIATE_STRICT=0

# ------------------------------------------------------------------------------
# 4. Storage & Persistence (SQLite WAL)
# ------------------------------------------------------------------------------
# Overrides default data/incidents.db and data/ather_timeseries.db
# ATHER_INCIDENTS_DB_PATH=data/incidents.db
# ATHER_TIMESERIES_DB_PATH=data/ather_timeseries.db

# ------------------------------------------------------------------------------
# 5. External Weather APIs (Optional)
# ------------------------------------------------------------------------------
# Optional commercial Open-Meteo API key for higher rate limits
# OPEN_METEO_API_KEY=your_open_meteo_key_here

# Weather Union API key for fetching live locality data (server-side only)
# WEATHERUNION_API_KEY=your_weatherunion_key_here
ATHER_WEATHERUNION_DAILY_CALLS=900

# Comma-separated USAF+WBAN station IDs for NOAA ISD access
# ATHER_NOAA_STATIONS=

# Optional shared secret token for authenticating push observations (/api/observations)
# ATHER_INGEST_TOKEN=your_secure_ingestion_token_here

# ------------------------------------------------------------------------------
# 6. Frontend Development Configuration
# ------------------------------------------------------------------------------
# Used by frontend/vite.config.ts dev server proxy
# ATHER_API_TARGET=http://127.0.0.1:8001
